# Gemini API 凭证（必填，真实值写入 .env，切勿写入本文件——本文件会被提交）
GEMINI_API_KEY=your-api-key-here

# 模型名（可选，默认值如下）
GEMINI_MODEL=gemini-3.5-flash

# 可选：API 超时（秒）与重试次数
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# 可选：连发消息防抖窗口（秒），默认 3
DEBOUNCE_SECONDS=3

# 可选：输入侧注入检测（Prompt-Guard-2-86M，CPU），默认开启；0 = 关闭
INJECTION_GUARD=1
# 可选：检测模型（ModelScope ID）
INJECTION_GUARD_MODEL=LLM-Research/Llama-Prompt-Guard-2-86M
